# Copy this file to .env before starting the stack.
# Never commit .env. Generate strong local secrets, for example:
#   openssl rand -hex 32

POSTGRES_DB=fida_ride
POSTGRES_USER=fida_ride
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

GO_TELEMETRY_PORT=8080
TELEMETRY_REDIS_DB=0
DRIVER_PRESENCE_TTL=20s
STALE_CLEANUP_INTERVAL=5s
STALE_CLEANUP_BATCH_SIZE=5000
WS_IDLE_TIMEOUT=60s
WS_PING_INTERVAL=25s
# Local-only fallback. Set false outside local development.
TELEMETRY_ALLOW_INSECURE_DRIVER_ID=true
WS_ALLOWED_ORIGINS=

# O(1) Redis-backed velocity-spoofing detection in the Go telemetry service.
TELEMETRY_MAX_SPEED_KPH=160
TELEMETRY_VELOCITY_MIN_WINDOW=2s
TELEMETRY_VELOCITY_MAX_WINDOW=90s
TELEMETRY_FRAUD_STATE_TTL=15m
TELEMETRY_FRAUD_REDIS_TIMEOUT=100ms
# Performance objective only; actual latency depends on Redis network RTT.
TELEMETRY_FRAUD_BUDGET=2ms

# Shared by NestJS JWT issuance and Go telemetry JWT validation.
JWT_HS256_SECRET=
JWT_ACCESS_TTL_SECONDS=900

NESTJS_CORE_PORT=3000
CORE_REDIS_DB=0

# Phone verification. Generate independently from JWT_HS256_SECRET.
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Local only: returns dev_code from /auth/phone/request.
OTP_DEV_ECHO=true
# In production set OTP_DEV_ECHO=false and point this at the SMS/notification gateway.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=

RIDE_BASE_FARE_RWF=1000
RIDE_PER_KM_RWF=500
DISPATCH_RADIUS_KM=5
DISPATCH_CANDIDATE_LIMIT=100

# Fare negotiation window and short-lived acceptance mutex.
BIDDING_TTL_SECONDS=120
BIDDING_ACCEPT_LOCK_TTL_MS=10000

# Fraud/risk engine. Enable only after FRAUD_DEVICE_HMAC_SECRET is provisioned.
FRAUD_DETECTION_ENABLED=false
# Independent 32+ character secret used only to HMAC device identifiers before storage.
FRAUD_DEVICE_HMAC_SECRET=
FRAUD_RISK_WINDOW_SECONDS=900
FRAUD_DEVICE_BIND_TTL_SECONDS=120
FRAUD_DEVICE_CLOCK_SKEW_MS=300000
FRAUD_ACCOUNT_STATE_CACHE_SECONDS=60
FRAUD_BLOCK_CACHE_TTL_SECONDS=86400
# A flagged account is an automatic security hold; suspended is the higher-confidence hold.
FRAUD_FLAG_THRESHOLD=70
FRAUD_SUSPEND_THRESHOLD=90
FRAUD_WEIGHT_DEVICE_PARALLEL_ACCOUNT=45
FRAUD_WEIGHT_DEVICE_CLOCK_SKEW=20
FRAUD_WEIGHT_INVALID_DEVICE_TIMESTAMP=15
FRAUD_WEIGHT_MOCK_LOCATION=70
FRAUD_WEIGHT_VELOCITY_JUMP=50

# Dynamic PostGIS/Redis surge engine. Keep disabled until reviewed zones are loaded.
SURGE_PRICING_ENABLED=false
SURGE_REFRESH_INTERVAL_MS=10000
SURGE_REFRESH_LOCK_TTL_MS=30000
SURGE_CACHE_TTL_SECONDS=45
SURGE_DEMAND_WINDOW_SECONDS=600
SURGE_RATIO_THRESHOLD=1.5
SURGE_START_MULTIPLIER=1.2
SURGE_MAX_MULTIPLIER=3.0
SURGE_PROGRESSIVE_SLOPE=0.4
# Maximum Redis GEOSEARCH candidates per zone. If reached, surge fails open to 1.0x.
SURGE_DRIVER_PREFILTER_LIMIT=20000
# Local transaction guards for spatial reads.
SURGE_DB_STATEMENT_TIMEOUT_MS=1500
SURGE_DB_LOCK_TIMEOUT_MS=100
SURGE_DB_IDLE_TX_TIMEOUT_MS=3000

# WhatsApp Cloud API booking bot. Leave disabled until all required values are set.
WHATSAPP_BOT_ENABLED=false
# Random secret chosen by us and configured as Meta webhook verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret. Never expose to clients.
WHATSAPP_APP_SECRET=
# WhatsApp Cloud API system-user/permanent token in production.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Pin this explicitly to the Graph API version approved for production.
WHATSAPP_GRAPH_API_VERSION=
# SHA-256 is required by default. Only enable legacy SHA-1 for a controlled migration.
WHATSAPP_ALLOW_LEGACY_SHA1=false
WHATSAPP_OUTBOUND_TIMEOUT_MS=8000
WHATSAPP_WORKER_POLL_MS=500
WHATSAPP_WORKER_BATCH_SIZE=10
WHATSAPP_WORKER_MAX_ATTEMPTS=5
WHATSAPP_PROCESSING_LEASE_SECONDS=120
WHATSAPP_SESSION_TTL_SECONDS=1800
WHATSAPP_BOOKING_MIN_CONFIDENCE=0.85

# Optional AI parser. Deterministic parsing remains available when this is false.
WHATSAPP_BOOKING_LLM_ENABLED=false
WHATSAPP_BOOKING_LLM_MODEL=
WHATSAPP_BOOKING_LLM_TIMEOUT_MS=6000
WHATSAPP_BOOKING_LLM_BYPASS_CONFIDENCE=0.92
OPENAI_API_KEY=

# Google Maps Geocoding API. Required when WHATSAPP_BOT_ENABLED=true.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_REGION=rw
GOOGLE_GEOCODING_COUNTRY=RW
# Optional Google v3 bounds bias: southwest_lat,southwest_lng|northeast_lat,northeast_lng
GOOGLE_GEOCODING_BOUNDS=
GOOGLE_GEOCODING_TIMEOUT_MS=5000
GOOGLE_GEOCODING_MIN_CONFIDENCE=0.82
